# ==============================================================================
# ShipFlowX Backend Configuration - Environment Template
# Copy this file to '.env' and populate with actual credentials.
# Do NOT check the '.env' file into source control (configured in .gitignore).
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB URI)
# Local Docker Dev URI: mongodb://mongodb:27017/shipflowx
# Local Dev URI: mongodb://127.0.0.1:27017/shipflowx
# Production URI Example: mongodb://db_admin:secure_password_here@mongodb_host:27017/shipflowx?authSource=admin
MONGO_URI=mongodb://127.0.0.1:27017/shipflowx

# Security Secrets (Keep long, complex, and unique)
JWT_SECRET=replace_with_a_secure_jwt_secret_hash_code_2026

# OAuth/SSO configurations (Optional for strict verification)
GOOGLE_CLIENT_ID=
